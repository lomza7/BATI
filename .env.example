# ============================================================
# Hellobat — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
#
# Required for local development: run `supabase start` first,
# then copy the output values below.
# ============================================================

# ---- Supabase -----------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# ---- Stripe -------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=whsec_

# ---- Claude API (Anthropic) ---------------------------------
ANTHROPIC_API_KEY=sk-ant-

# ---- Sentry (Error Tracking) --------------------------------
NEXT_PUBLIC_SENTRY_DSN=https://
SENTRY_AUTH_TOKEN=
SENTRY_ORG=hellobat
SENTRY_PROJECT=hellobat-nextjs

# ---- App Configuration ---------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=local
NODE_ENV=development

# ---- Vercel (CI/CD only, not needed locally) ----------------
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# ---- Email (Transactional) ----------------------------------
# RESEND_API_KEY=re_
